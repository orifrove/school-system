# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НИКОГДА не должен попадать в Git (см. .gitignore).

# Django
SECRET_KEY=change-me-to-a-random-secret-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Database (PostgreSQL)
# Формат: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://edu_dev:CHANGE_ME@localhost:5432/edu_center_dev

# Telegram Bot (используется начиная с Phase 6 — уже сейчас фиксируем формат
# переменной, чтобы .env.example был полным списком того, что понадобится)
TELEGRAM_BOT_TOKEN=

# Redis / Celery (используется начиная с V2, см. architecture.md раздел 7)
REDIS_URL=redis://localhost:6379/0
